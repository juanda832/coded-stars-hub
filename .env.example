# Local demonstration sessions only. Use a long random value. Personal access uses Clerk.
SESSION_SECRET=

# Personal beta access (configured privately on the hosting service).
# NEXT_PUBLIC_CODED_AUTH_MODE=clerk
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CODED_ADMIN_ISA_EMAIL=
# CODED_ADMIN_ELA_EMAIL=
# CODED_OWNER_EMAIL=

# Keep disabled until real account data has been explicitly authorized.
# CODED_ALLOW_REAL_ACCOUNTS=false

# Shared storage, provisioned privately through Vercel Marketplace (Neon).
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# Production defaults to coded_hub_beta; previews to coded_hub_preview.
# Set this explicitly when running migrations or isolated storage tests.
# CODED_DATABASE_SCHEMA=

# Private, revocable calendar subscriptions. Never expose this key to the browser.
# CODED_CALENDAR_SECRET=
# CODED_PUBLIC_SITE_URL=https://coded-stars-beta.vercel.app
